rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Core Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? getUserDoc().data.role : (request.auth.token.role != null ? request.auth.token.role : '');
    }

    function getUserSchoolId() {
      return hasUserDoc() ? getUserDoc().data.schoolId : (request.auth.token.schoolId != null ? request.auth.token.schoolId : '');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'superAdmin' ||
        getUserRole() == 'superAdmin'
      );
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (getUserSchoolId() == schoolId && getUserRole() in ['schoolOwner', 'principal', 'accountant', 'admin'])
      );
    }

    function isSchoolStaff(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (getUserSchoolId() == schoolId && getUserRole() in ['schoolOwner', 'principal', 'accountant', 'admin', 'teacher'])
      );
    }

    // Check if the authenticated user is an explicitly linked parent for the given student
    function isParentOfStudent(studentData) {
      return isSignedIn() && (
        getUserSchoolId() == studentData.schoolId &&
        getUserRole() == 'parent' && (
          // 1. Direct parent ID link
          (studentData.parentId != null && studentData.parentId == request.auth.uid) ||
          // 2. Parent IDs array contains auth UID
          (studentData.parentIds != null && request.auth.uid in studentData.parentIds) ||
          // 3. User document linkedStudentIds contains student ID
          (hasUserDoc() && getUserDoc().data.linkedStudentIds != null && studentData.id in getUserDoc().data.linkedStudentIds)
        )
      );
    }

    // Check if the authenticated parent is linked to a student by ID
    function isParentLinkedToStudentId(studentId, schoolId) {
      return isSignedIn() && (
        getUserSchoolId() == schoolId &&
        getUserRole() == 'parent' &&
        hasUserDoc() &&
        getUserDoc().data.linkedStudentIds != null &&
        studentId in getUserDoc().data.linkedStudentIds
      );
    }

    // -------------------------------------------------------------
    // Schools Collection
    // -------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if true; // Public read for portal discovery and login validation
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin() || isSchoolAdmin(schoolId);
    }

    // -------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (hasUserDoc() && resource.data.schoolId != null && getUserSchoolId() == resource.data.schoolId && isSchoolAdmin(resource.data.schoolId))
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (hasUserDoc() && resource.data.schoolId != null && getUserSchoolId() == resource.data.schoolId && isSchoolAdmin(resource.data.schoolId))
      );
      allow delete: if isSuperAdmin() || (hasUserDoc() && isSchoolAdmin(resource.data.schoolId));
    }

    // -------------------------------------------------------------
    // Students Collection (Explicit Parent-Student Relationship Enforced)
    // -------------------------------------------------------------
    match /students/{studentId} {
      // Parents can ONLY read students explicitly linked to their parent UID/account.
      // Teachers & Admins can read all students within their school.
      // Super Admins have platform-wide read.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolStaff(resource.data.schoolId) ||
        isParentOfStudent(resource.data)
      );
      
      // Only school staff and admins can create, update, or withdraw student records.
      allow create: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(resource.data.schoolId)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Results & Examinations
    // -------------------------------------------------------------
    match /results/{resultId} {
      // Parents can only read results belonging to their linked student.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolStaff(resource.data.schoolId) ||
        isParentLinkedToStudentId(resource.data.studentId, resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    match /examinations/{examId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Attendance Records
    // -------------------------------------------------------------
    match /attendance/{attendanceId} {
      // Parents can only read attendance records belonging to their linked student.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolStaff(resource.data.schoolId) ||
        isParentLinkedToStudentId(resource.data.studentId, resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Fee Structures & Fee Payments
    // -------------------------------------------------------------
    match /feePayments/{paymentId} {
      // Parents can only read fee payments for their linked student.
      allow read: if isSignedIn() && (
        isSuperAdmin() ||
        isSchoolStaff(resource.data.schoolId) ||
        isParentLinkedToStudentId(resource.data.studentId, resource.data.schoolId)
      );
      allow create, update: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(request.resource.data.schoolId) ||
        isParentLinkedToStudentId(request.resource.data.studentId, request.resource.data.schoolId)
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId)
      );
    }

    match /feeStructures/{feeId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(request.resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Staff & Classrooms & Subjects
    // -------------------------------------------------------------
    match /teachers/{teacherId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(request.resource.data.schoolId)
      );
    }

    match /classrooms/{classroomId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(request.resource.data.schoolId)
      );
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(request.resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Store & POS Transactions
    // -------------------------------------------------------------
    match /storeItems/{itemId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    match /posTransactions/{txId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    // -------------------------------------------------------------
    // Communications, Messages & Audit Logs
    // -------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolStaff(request.resource.data.schoolId)
      );
    }

    match /communicationLogs/{logId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /smsMessages/{smsId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId)
      );
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId)
      );
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit trail
    }

    // -------------------------------------------------------------
    // Settings & Platform Configurations
    // -------------------------------------------------------------
    match /schoolSettings/{schoolId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == schoolId)
      );
      allow write: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(schoolId)
      );
    }

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /subscriptionTransactions/{txId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSignedIn();
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (
        isSuperAdmin() || 
        (hasUserDoc() && getUserSchoolId() == resource.data.schoolId)
      );
      allow write: if isSuperAdmin();
    }
  }
}
